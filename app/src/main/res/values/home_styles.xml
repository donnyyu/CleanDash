<?xml version="1.0" encoding="utf-8"?>
<!-- View styles for the Home layouts (home_glass, home_instrument, home_rail, home_analog, home_halo, home_cards). -->
<resources>

    <!-- A · Glass Cockpit -->
    <style name="Glass" />

    <style name="Glass.Row">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">horizontal</item>
    </style>

    <!-- glass_tile insets its own background by 8dp; 30dp padding leaves 22dp inside the card. -->
    <style name="Glass.Tile">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">30dp</item>
        <item name="android:background">@drawable/glass_tile</item>
    </style>

    <style name="Glass.TileIcon">
        <item name="android:layout_width">@dimen/glass_icon</item>
        <item name="android:layout_height">@dimen/glass_icon</item>
        <item name="android:importantForAccessibility">no</item>
        <item name="android:tint">@color/glass_text</item>
    </style>

    <style name="Glass.TileLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/inter_tight_medium</item>
        <item name="android:ellipsize">end</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/glass_text</item>
        <item name="android:textSize">@dimen/glass_label</item>
    </style>

    <style name="Glass.TileHint">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/inter_tight_regular</item>
        <item name="android:text">@string/tile_not_found</item>
        <item name="android:textColor">@color/glass_muted</item>
        <item name="android:textSize">16sp</item>
        <item name="android:visibility">gone</item>
    </style>

    <style name="Glass.Button">
        <item name="android:layout_width">60dp</item>
        <item name="android:layout_height">60dp</item>
        <item name="android:padding">15dp</item>
        <item name="android:background">?android:attr/selectableItemBackgroundBorderless</item>
        <item name="android:tint">@color/glass_text</item>
    </style>

    <!-- B · Instrument -->
    <style name="Instrument" />

    <style name="Instrument.Tile">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">6dp</item>
        <item name="android:layout_marginEnd">6dp</item>
        <item name="android:gravity">center</item>
        <item name="android:orientation">vertical</item>
        <item name="android:background">@drawable/instrument_tile</item>
    </style>

    <style name="Instrument.TileIcon">
        <item name="android:layout_width">52dp</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:importantForAccessibility">no</item>
        <item name="android:tint">@color/instrument_text</item>
    </style>

    <style name="Instrument.TileLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:fontFamily">@font/barlow_semibold</item>
        <item name="android:letterSpacing">0.14</item>
        <item name="android:ellipsize">end</item>
        <item name="android:maxLines">1</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/instrument_text</item>
        <item name="android:textSize">@dimen/instrument_label</item>
    </style>

    <style name="Instrument.Button">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:padding">16dp</item>
        <item name="android:background">@drawable/instrument_button</item>
        <item name="android:tint">@color/instrument_text</item>
    </style>

    <style name="Instrument.Caption">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/barlow_semibold</item>
        <item name="android:letterSpacing">0.2</item>
        <item name="android:maxLines">1</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/instrument_muted</item>
        <item name="android:textSize">13sp</item>
    </style>

    <!-- C · Driver Rail (light) -->
    <style name="Rail" />

    <style name="Rail.Item">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:layout_marginBottom">2dp</item>
        <item name="android:gravity">center</item>
        <item name="android:orientation">vertical</item>
        <item name="android:background">@drawable/rail_item</item>
    </style>

    <style name="Rail.ItemIcon">
        <item name="android:layout_width">@dimen/rail_icon</item>
        <item name="android:layout_height">@dimen/rail_icon</item>
        <item name="android:importantForAccessibility">no</item>
        <item name="android:tint">@color/rail_text</item>
    </style>

    <style name="Rail.ItemLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:fontFamily">@font/space_grotesk_semibold</item>
        <item name="android:ellipsize">end</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/rail_text</item>
        <item name="android:textSize">@dimen/rail_label</item>
    </style>

    <style name="Rail.Button">
        <item name="android:layout_width">60dp</item>
        <item name="android:layout_height">60dp</item>
        <item name="android:padding">17dp</item>
        <item name="android:background">@drawable/rail_button</item>
        <item name="android:tint">@color/rail_text</item>
    </style>

    <!-- D · Analog Studio (light). A key's ripple sits on its round icon, which follows the tile's pressed
         state through duplicateParentState. -->
    <style name="Analog" />

    <style name="Analog.Tile">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center_horizontal</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="Analog.TileIcon">
        <item name="android:layout_width">116dp</item>
        <item name="android:layout_height">116dp</item>
        <item name="android:padding">30dp</item>
        <item name="android:background">@drawable/analog_button</item>
        <item name="android:duplicateParentState">true</item>
        <item name="android:importantForAccessibility">no</item>
        <item name="android:tint">@color/analog_text</item>
    </style>

    <style name="Analog.TileLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:fontFamily">@font/archivo_semibold</item>
        <item name="android:ellipsize">end</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/analog_text</item>
        <item name="android:textSize">20sp</item>
    </style>

    <style name="Analog.Button">
        <item name="android:layout_width">64dp</item>
        <item name="android:layout_height">64dp</item>
        <item name="android:padding">20dp</item>
        <item name="android:background">@drawable/analog_small_button</item>
        <item name="android:tint">@color/analog_text</item>
    </style>

    <!-- E · Night Halo -->
    <style name="Halo" />

    <style name="Halo.Tile">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/halo_key_gap</item>
        <item name="android:layout_marginBottom">@dimen/halo_key_gap</item>
        <item name="android:gravity">center_horizontal</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="Halo.TileIcon">
        <item name="android:layout_width">@dimen/halo_key</item>
        <item name="android:layout_height">@dimen/halo_key</item>
        <item name="android:padding">@dimen/halo_key_padding</item>
        <item name="android:background">@drawable/halo_button</item>
        <item name="android:duplicateParentState">true</item>
        <item name="android:importantForAccessibility">no</item>
        <item name="android:tint">@color/halo_text</item>
    </style>

    <style name="Halo.TileLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:fontFamily">@font/outfit_regular</item>
        <item name="android:ellipsize">end</item>
        <item name="android:maxWidth">@dimen/halo_label_max</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/halo_muted</item>
        <item name="android:textSize">18sp</item>
    </style>

    <style name="Halo.Button">
        <item name="android:layout_width">64dp</item>
        <item name="android:layout_height">64dp</item>
        <item name="android:padding">20dp</item>
        <item name="android:background">@drawable/halo_button</item>
        <item name="android:tint">@color/halo_text</item>
    </style>

    <!-- F · Color Cards -->
    <style name="Cards" />

    <style name="Cards.Card">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">10dp</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingStart">28dp</item>
        <item name="android:paddingTop">26dp</item>
        <item name="android:paddingEnd">28dp</item>
        <item name="android:paddingBottom">24dp</item>
    </style>

    <style name="Cards.CardIcon">
        <item name="android:layout_width">60dp</item>
        <item name="android:layout_height">60dp</item>
        <item name="android:importantForAccessibility">no</item>
        <item name="android:tint">@android:color/white</item>
    </style>

    <style name="Cards.CardLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/plus_jakarta_extrabold</item>
        <item name="android:letterSpacing">-0.015</item>
        <item name="android:ellipsize">end</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textSize">@dimen/cards_label</item>
    </style>

    <style name="Cards.CardHint">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/plus_jakarta_semibold</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textSize">19sp</item>
    </style>
</resources>
