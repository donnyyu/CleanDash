<?xml version="1.0" encoding="utf-8"?>
<!-- Inset: the 8dp gap between tiles is part of each cell, so a two-cell tile lines up with the grid. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android" android:inset="8dp">
<ripple android:color="#22FFFFFF">
    <item><shape android:shape="rectangle"><solid android:color="@color/glass_card" /><stroke android:width="1dp" android:color="@color/glass_line" /><corners android:radius="28dp" /></shape></item>
</ripple>
</inset>
