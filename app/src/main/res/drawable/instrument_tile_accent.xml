<?xml version="1.0" encoding="utf-8"?>
<!-- The Instrument tile with a 3dp accent bar along its top edge. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#22FFFFFF">
    <item><shape android:shape="rectangle"><solid android:color="@color/instrument_tile" /><stroke android:width="1dp" android:color="@color/instrument_line" /><corners android:radius="4dp" /></shape></item>
    <item android:gravity="top" android:height="3dp"><shape android:shape="rectangle"><solid android:color="@color/instrument_accent" /><corners android:radius="1dp" /></shape></item>
</ripple>
