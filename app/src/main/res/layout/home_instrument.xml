<?xml version="1.0" encoding="utf-8"?>
<!-- B · Instrument: a big condensed clock, an LCD-style media panel, and a row of eight hard keys.
     Tiles carry android:tag = a Tiles id; MainActivity fills their icon and label. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/instrument_bg"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:paddingStart="34dp"
    android:paddingTop="20dp"
    android:paddingEnd="34dp"
    android:paddingBottom="28dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Hold the clock for Theme, Home screen settings and Reset. -->
            <LinearLayout
                android:id="@+id/clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?android:attr/selectableItemBackground"
                android:orientation="vertical">

                <TextClock
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="-14dp"
                    android:fontFamily="@font/barlow_condensed_light"
                    android:format12Hour="h:mm"
                    android:format24Hour="HH:mm"
                    android:includeFontPadding="false"
                    android:letterSpacing="-0.01"
                    android:textColor="@color/instrument_text"
                    android:textSize="176sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextClock
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/barlow_condensed_medium"
                        android:format12Hour="EEE d MMM"
                        android:format24Hour="EEE d MMM"
                        android:letterSpacing="0.15"
                        android:textAllCaps="true"
                        android:textColor="@color/instrument_muted"
                        android:textSize="24sp" />

                    <View
                        android:layout_width="40dp"
                        android:layout_height="2dp"
                        android:layout_marginStart="16dp"
                        android:background="@drawable/instrument_bar" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/set_home"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/instrument_pill"
                android:fontFamily="@font/barlow_semibold"
                android:gravity="center"
                android:letterSpacing="0.15"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:text="@string/set_home"
                android:textAllCaps="true"
                android:textColor="@color/instrument_accent"
                android:textSize="14sp"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/media_card"
            android:layout_width="470dp"
            android:layout_height="wrap_content"
            android:background="@drawable/instrument_panel"
            android:foreground="?android:attr/selectableItemBackground"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingTop="22dp"
            android:paddingEnd="28dp"
            android:paddingBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/media_source"
                    style="@style/Instrument.Caption"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/media_state"
                    style="@style/Instrument.Caption"
                    android:layout_marginStart="16dp"
                    android:textColor="@color/instrument_accent" />
            </LinearLayout>

            <TextView
                android:id="@+id/media_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:ellipsize="end"
                android:fontFamily="@font/barlow_condensed_regular"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:textColor="@color/instrument_accent"
                android:textSize="60sp" />

            <TextView
                android:id="@+id/media_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:ellipsize="end"
                android:fontFamily="@font/barlow_medium"
                android:singleLine="true"
                android:textColor="@color/instrument_text"
                android:textSize="19sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/media_prev"
                    style="@style/Instrument.Button"
                    android:contentDescription="@string/media_prev"
                    android:src="@drawable/ic_skip_previous" />

                <ImageView
                    android:id="@+id/media_play"
                    style="@style/Instrument.Button"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/instrument_button_accent"
                    android:contentDescription="@string/media_play"
                    android:src="@drawable/ic_play"
                    android:tint="@color/instrument_accent" />

                <ImageView
                    android:id="@+id/media_next"
                    style="@style/Instrument.Button"
                    android:contentDescription="@string/media_next"
                    android:src="@drawable/ic_skip_next" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="168dp"
        android:orientation="horizontal">

        <LinearLayout style="@style/Instrument.Tile" android:background="@drawable/instrument_tile_accent" android:tag="maps">
            <ImageView android:tag="icon" style="@style/Instrument.TileIcon" />
            <TextView android:tag="label" style="@style/Instrument.TileLabel" />
        </LinearLayout>

        <LinearLayout style="@style/Instrument.Tile" android:tag="carplay">
            <ImageView android:tag="icon" style="@style/Instrument.TileIcon" />
            <TextView android:tag="label" style="@style/Instrument.TileLabel" />
        </LinearLayout>

        <LinearLayout style="@style/Instrument.Tile" android:tag="radio">
            <ImageView android:tag="icon" style="@style/Instrument.TileIcon" />
            <TextView android:tag="label" style="@style/Instrument.TileLabel" />
        </LinearLayout>

        <LinearLayout style="@style/Instrument.Tile" android:tag="music">
            <ImageView android:tag="icon" style="@style/Instrument.TileIcon" />
            <TextView android:tag="label" style="@style/Instrument.TileLabel" />
        </LinearLayout>

        <LinearLayout style="@style/Instrument.Tile" android:tag="bluetooth">
            <ImageView android:tag="icon" style="@style/Instrument.TileIcon" />
            <TextView android:tag="label" style="@style/Instrument.TileLabel" />
        </LinearLayout>

        <LinearLayout style="@style/Instrument.Tile" android:tag="eq">
            <ImageView android:tag="icon" style="@style/Instrument.TileIcon" />
            <TextView android:tag="label" style="@style/Instrument.TileLabel" />
        </LinearLayout>

        <LinearLayout style="@style/Instrument.Tile" android:tag="settings">
            <ImageView android:tag="icon" style="@style/Instrument.TileIcon" />
            <TextView android:tag="label" style="@style/Instrument.TileLabel" />
        </LinearLayout>

        <LinearLayout style="@style/Instrument.Tile" android:tag="apps">
            <ImageView android:tag="icon" style="@style/Instrument.TileIcon" />
            <TextView android:tag="label" style="@style/Instrument.TileLabel" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
