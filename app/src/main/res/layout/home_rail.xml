<?xml version="1.0" encoding="utf-8"?>
<!-- C · Driver Rail (light): a white icon rail on the driver's side, a big clock, now playing and a large
     CarPlay card. CarPlay appears twice, on the rail and as the card. Tiles carry android:tag = a Tiles id;
     MainActivity fills their icon and label. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/rail_bg"
    android:fitsSystemWindows="true"
    android:orientation="horizontal"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="112dp"
        android:layout_height="match_parent"
        android:background="@drawable/rail_card"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingTop="12dp"
        android:paddingEnd="10dp"
        android:paddingBottom="14dp">

        <LinearLayout style="@style/Rail.Item" android:background="@drawable/rail_item_accent" android:tag="maps">
            <ImageView android:tag="icon" style="@style/Rail.ItemIcon" android:tint="@color/rail_on_accent" />
            <TextView android:tag="label" style="@style/Rail.ItemLabel" android:textColor="@color/rail_on_accent" />
        </LinearLayout>

        <LinearLayout style="@style/Rail.Item" android:tag="carplay">
            <ImageView android:tag="icon" style="@style/Rail.ItemIcon" />
            <TextView android:tag="label" style="@style/Rail.ItemLabel" />
        </LinearLayout>

        <LinearLayout style="@style/Rail.Item" android:tag="radio">
            <ImageView android:tag="icon" style="@style/Rail.ItemIcon" />
            <TextView android:tag="label" style="@style/Rail.ItemLabel" />
        </LinearLayout>

        <LinearLayout style="@style/Rail.Item" android:tag="music">
            <ImageView android:tag="icon" style="@style/Rail.ItemIcon" />
            <TextView android:tag="label" style="@style/Rail.ItemLabel" />
        </LinearLayout>

        <LinearLayout style="@style/Rail.Item" android:tag="bluetooth">
            <ImageView android:tag="icon" style="@style/Rail.ItemIcon" />
            <TextView android:tag="label" style="@style/Rail.ItemLabel" />
        </LinearLayout>

        <LinearLayout style="@style/Rail.Item" android:tag="eq">
            <ImageView android:tag="icon" style="@style/Rail.ItemIcon" />
            <TextView android:tag="label" style="@style/Rail.ItemLabel" />
        </LinearLayout>

        <LinearLayout style="@style/Rail.Item" android:tag="settings">
            <ImageView android:tag="icon" style="@style/Rail.ItemIcon" />
            <TextView android:tag="label" style="@style/Rail.ItemLabel" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/rail_apps"
            android:tag="apps">

            <ImageView
                android:tag="icon"
                style="@style/Rail.ItemIcon"
                android:layout_gravity="center" />
        </FrameLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="24dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Equal space above and below centres the clock row above the cards. -->
        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Hold the clock for Theme, Home screen settings and Reset. -->
            <LinearLayout
                android:id="@+id/clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?android:attr/selectableItemBackground"
                android:orientation="vertical">

                <TextClock
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/space_grotesk_medium"
                    android:format12Hour="h:mm"
                    android:format24Hour="HH:mm"
                    android:includeFontPadding="false"
                    android:letterSpacing="-0.04"
                    android:textColor="@color/rail_text"
                    android:textSize="132sp" />

                <TextClock
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/space_grotesk_medium"
                    android:format12Hour="EEEE, d MMMM"
                    android:format24Hour="EEEE, d MMMM"
                    android:textColor="@color/rail_muted"
                    android:textSize="24sp" />
            </LinearLayout>

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/set_home"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:background="@drawable/rail_pill"
                android:fontFamily="@font/space_grotesk_semibold"
                android:gravity="center"
                android:paddingStart="22dp"
                android:paddingEnd="22dp"
                android:text="@string/set_home"
                android:textColor="@color/rail_accent"
                android:textSize="15sp"
                android:visibility="gone" />
        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="264dp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/media_card"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="2"
                android:background="@drawable/rail_card"
                android:foreground="?android:attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="28dp">

                <ImageView
                    android:id="@+id/media_art"
                    android:layout_width="200dp"
                    android:layout_height="200dp"
                    android:background="@drawable/rail_art"
                    android:importantForAccessibility="no"
                    android:padding="64dp"
                    android:src="@drawable/ic_music"
                    android:tint="@color/rail_on_accent" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="28dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/media_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="@font/space_grotesk_semibold"
                        android:singleLine="true"
                        android:textColor="@color/rail_text"
                        android:textSize="30sp" />

                    <TextView
                        android:id="@+id/media_artist"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:fontFamily="@font/space_grotesk_medium"
                        android:singleLine="true"
                        android:textColor="@color/rail_muted"
                        android:textSize="19sp" />

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="6dp"
                        android:layout_marginTop="18dp"
                        android:background="@drawable/rail_track">

                        <View
                            android:id="@+id/media_progress"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/rail_progress"
                            android:scaleX="0" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/media_prev"
                            style="@style/Rail.Button"
                            android:contentDescription="@string/media_prev"
                            android:src="@drawable/ic_skip_previous" />

                        <ImageView
                            android:id="@+id/media_play"
                            android:layout_width="76dp"
                            android:layout_height="76dp"
                            android:layout_marginStart="16dp"
                            android:layout_marginEnd="16dp"
                            android:background="@drawable/rail_play"
                            android:contentDescription="@string/media_play"
                            android:padding="22dp"
                            android:src="@drawable/ic_play"
                            android:tint="@color/rail_on_accent" />

                        <ImageView
                            android:id="@+id/media_next"
                            style="@style/Rail.Button"
                            android:contentDescription="@string/media_next"
                            android:src="@drawable/ic_skip_next" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="20dp"
                android:layout_weight="1"
                android:background="@drawable/rail_carplay"
                android:orientation="vertical"
                android:padding="28dp"
                android:tag="carplay">

                <ImageView
                    android:tag="icon"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:importantForAccessibility="no"
                    android:tint="@color/rail_on_accent" />

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <TextView
                    android:tag="label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/space_grotesk_semibold"
                    android:textColor="@color/rail_on_accent"
                    android:textSize="32sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/space_grotesk_medium"
                    android:text="@string/carplay_hint"
                    android:textColor="@color/rail_on_accent"
                    android:textSize="18sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
